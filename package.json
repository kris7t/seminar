{
  "name": "@seminar/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Maintain scientific talks and lectures as Markdown presentations",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24"
  },
  "scripts": {
    "build": "tsc --build && npm run build --workspaces --if-present",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:compositors": "node --test scripts/compositors/",
    "check": "npm run format:check && npm run build && npm run lint && npm run test",
    "dev": "npm run dev --workspace @seminar/example",
    "present": "npm run present --workspace @seminar/example",
    "vscode:package": "npm run package --workspace seminar-vscode",
    "docs:dev": "npm run dev --workspace @seminar/docs --",
    "docs:build": "npm run build --workspace @seminar/docs --",
    "docs:preview": "npm run preview --workspace @seminar/docs --",
    "build:packages": "node scripts/release.mjs build",
    "release:version": "node scripts/release.mjs version",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "release:smoke": "node scripts/smoke-release.mjs",
    "release:publish": "node scripts/release.mjs publish"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.26.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "core-js": false
  }
}
