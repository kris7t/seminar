{
  "name": "@seminar/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core Markdown presentation model for Seminar",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/*.json": {
      "default": "./dist/i18n/locales/*.json"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@mui/icons-material": "^9.5.0",
    "html-to-image": "^1.11.13"
  }
}
