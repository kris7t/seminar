{
  "name": "@seminar/rollup-plugin",
  "version": "0.2.1",
  "description": "Rollup and Vite plugin for Seminar presentations",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!src/fixtures",
    "!src/test",
    "!dist/test",
    "!dist/fixtures",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@rollup/pluginutils": "^5.4.0",
    "@seminar/mdx": "0.2.1",
    "@seminar/theme-default": "0.2.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@seminar/core": "0.2.1",
    "@seminar/elements": "0.2.1",
    "@seminar/plugin-mathjax": "0.2.1",
    "rollup": "^4.64.6",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/rollup-plugin"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/release.mjs prepare"
  }
}
