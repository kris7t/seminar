{
  "scopeName": "source.seminar-deck.injection",
  "injectionSelector": "L:source.seminar-deck -markup.code -markup.raw -meta.embedded -string -comment.block",
  "patterns": [
    {
      "include": "#code-fence-mermaid"
    },
    {
      "include": "#math-flow"
    },
    {
      "include": "#math-text"
    },
    {
      "include": "#directive-closing"
    },
    {
      "include": "#directive-notes"
    },
    {
      "include": "#directive-slide"
    },
    {
      "include": "#directive-step"
    },
    {
      "include": "#directive-reuse"
    },
    {
      "include": "#directive-block"
    },
    {
      "include": "#not-directive-text"
    },
    {
      "include": "#directive-text"
    },
    {
      "include": "#image-attributes"
    }
  ],
  "repository": {
    "math-flow": {
      "begin": "(?:^|\\G)[\\t ]*(\\${2,})[^\\n\\r$]*$",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.math.seminar seminar.math.delimiter"
        }
      },
      "end": "(?:^|\\G)[\\t ]*(\\1)[\\t ]*$",
      "endCaptures": {
        "1": {
          "name": "string.other.end.math.seminar seminar.math.delimiter"
        }
      },
      "contentName": "meta.embedded.math.seminar seminar.math.content",
      "patterns": [
        {
          "include": "#math-content"
        }
      ]
    },
    "math-text": {
      "begin": "(?<![\\\\$])(\\$+)(?!\\$)(?=.+?(?<!\\$)\\1(?!\\$))",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.math.seminar seminar.math.delimiter"
        }
      },
      "end": "(?<!\\$)(\\1)(?!\\$)",
      "endCaptures": {
        "1": {
          "name": "string.other.end.math.seminar seminar.math.delimiter"
        }
      },
      "contentName": "meta.embedded.math.seminar seminar.math.content",
      "patterns": [
        {
          "include": "#math-content"
        }
      ]
    },
    "directive-closing": {
      "match": "(?:^|\\G)[\\t ]*(:{3,})[\\t ]*$",
      "captures": {
        "1": {
          "name": "string.other.end.directive.seminar seminar.directive.delimiter"
        }
      }
    },
    "directive-block": {
      "begin": "(?:^|\\G)[\\t ]*(:{2,})((?>[^\\s\\p{P}\\p{S}](?:[^\\s\\p{P}\\p{S}]|[-_])*)(?<![-_])(?!:))",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.directive.seminar seminar.directive.delimiter"
        },
        "2": {
          "name": "entity.name.tag.directive.seminar seminar.directive.name"
        }
      },
      "end": "(?!\\[|\\{[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "patterns": [
        {
          "include": "#directive-label"
        },
        {
          "include": "#attribute-block"
        }
      ]
    },
    "directive-text": {
      "begin": "(?<!:)(:)((?>[^\\s\\p{P}\\p{S}](?:[^\\s\\p{P}\\p{S}]|[-_])*)(?<![-_])(?!:))",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.directive.seminar seminar.directive.delimiter"
        },
        "2": {
          "name": "entity.name.tag.directive.seminar seminar.directive.name"
        }
      },
      "end": "(?!\\[|\\{[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "patterns": [
        {
          "include": "#directive-label"
        },
        {
          "include": "#attribute-block"
        }
      ]
    },
    "directive-label": {
      "begin": "\\[(?=[^\\n]*\\])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.label.begin.seminar seminar.directive.label.delimiter"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.label.end.seminar seminar.directive.label.delimiter"
        }
      },
      "contentName": "meta.label.directive.seminar seminar.directive.label.text",
      "patterns": [
        {
          "include": "source.seminar-deck#markdown-text"
        }
      ]
    },
    "image-attributes": {
      "begin": "(!\\[(?:[^\\]\\\\]|\\\\.)*\\](?:\\((?:[^()\\\\]|\\\\.|\\([^()]*\\))*\\)|\\[[^\\]]*\\])?)(?=\\{[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "source.seminar-deck#markdown-text"
            }
          ]
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#attribute-block"
        }
      ]
    },
    "attribute-block": {
      "begin": "\\{(?=[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attributes.begin.seminar seminar.attribute.delimiter"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attributes.end.seminar seminar.attribute.delimiter"
        }
      },
      "name": "meta.attributes.seminar",
      "patterns": [
        {
          "include": "#attribute-step"
        },
        {
          "include": "#attribute-words"
        }
      ]
    },
    "attribute-words": {
      "patterns": [
        {
          "match": "#[^\\s\"'=#.{}]+",
          "name": "entity.other.attribute-name.id.seminar seminar.attribute.id"
        },
        {
          "match": "\\.[^\\s\"'=#.{}]+",
          "name": "entity.other.attribute-name.class.seminar seminar.attribute.class"
        },
        {
          "match": "([A-Za-z_][\\w-]*)(=)(\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.seminar seminar.attribute.name"
            },
            "2": {
              "name": "keyword.operator.assignment.seminar seminar.attribute.separator"
            },
            "3": {
              "name": "string.unquoted.attribute-value.seminar seminar.attribute.value"
            }
          }
        },
        {
          "match": "[A-Za-z_][\\w-]*",
          "name": "entity.other.attribute-name.seminar seminar.attribute.name"
        }
      ]
    },
    "not-directive-text": {
      "match": "(?<!:):(?=[^\\s\\p{P}\\p{S}](?:[^\\s\\p{P}\\p{S}]|[-_])*:)"
    },
    "math-content": {
      "patterns": [
        {
          "match": "((\\\\)(?:begin|end))(\\{)([^{}\\n]*)(\\})",
          "captures": {
            "1": {
              "name": "support.function.be.latex"
            },
            "2": {
              "name": "punctuation.definition.function.latex"
            },
            "3": {
              "name": "punctuation.definition.arguments.begin.latex"
            },
            "4": {
              "name": "variable.parameter.function.latex"
            },
            "5": {
              "name": "punctuation.definition.arguments.end.latex"
            }
          }
        },
        {
          "include": "text.tex#math-content"
        }
      ]
    },
    "code-fence-props": {
      "patterns": [
        {
          "match": "\"[^\"]*\"|'[^']*'|\\{[^{}]*\\}"
        },
        {
          "match": "(?<!\\S)((?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))(?!\\S)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#attribute-step"
                },
                {
                  "include": "#attribute-words"
                }
              ]
            }
          }
        }
      ]
    },
    "code-fence-mermaid": {
      "begin": "(?:^|\\G)[\\t ]*(`{3,}|~{3,})[\\t ]*((?i:mermaid))(?:[\\t ]+([^\\n\\r`]+))?[\\t ]*$",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.code.fenced.mdx"
        },
        "2": {
          "name": "entity.name.function.mdx"
        },
        "3": {
          "patterns": [
            {
              "include": "#code-fence-props"
            }
          ]
        }
      },
      "end": "(?:^|\\G)[\\t ]*(\\1)[\\t ]*$",
      "endCaptures": {
        "1": {
          "name": "string.other.end.code.fenced.mdx"
        }
      },
      "name": "markup.code.mermaid.mdx",
      "contentName": "meta.embedded.block.mermaid",
      "patterns": [
        {
          "include": "source.seminar-deck.mermaid"
        }
      ]
    },
    "directive-reuse": {
      "begin": "(?:^|\\G)[\\t ]*(::)(include|recap)(?![^\\s\\p{P}\\p{S}]|[-_:])",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.directive.seminar seminar.directive.delimiter.reuse"
        },
        "2": {
          "name": "keyword.control.import.seminar seminar.directive.name.reuse"
        }
      },
      "end": "(?!\\[|\\{[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "patterns": [
        {
          "include": "#directive-label"
        },
        {
          "include": "#attribute-block"
        }
      ]
    },
    "directive-notes": {
      "begin": "(?:^|\\G)[\\t ]*(:{3,})(notes)(?![^\\s\\p{P}\\p{S}]|[-_:])",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.directive.seminar seminar.directive.delimiter"
        },
        "2": {
          "name": "entity.name.type.notes.seminar seminar.directive.name.notes"
        }
      },
      "while": "(?:^|\\G)(?![\\t ]*\\1:*[\\t ]*$)",
      "contentName": "comment.notes.seminar seminar.notes.text",
      "patterns": [
        {
          "include": "#directive-label"
        },
        {
          "include": "#attribute-block"
        },
        {
          "include": "source.seminar-deck"
        }
      ]
    },
    "attribute-step": {
      "match": "(?<![^\\s{])step(?![^\\s}])",
      "name": "entity.name.function.step.seminar seminar.attribute.name.step"
    },
    "slide-attribute-block": {
      "begin": "\\{(?=[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attributes.begin.seminar seminar.attribute.delimiter"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attributes.end.seminar seminar.attribute.delimiter"
        }
      },
      "name": "meta.attributes.seminar",
      "patterns": [
        {
          "include": "#attribute-words"
        }
      ]
    },
    "directive-slide": {
      "begin": "(?:^|\\G)[\\t ]*(::)(slide)(?![^\\s\\p{P}\\p{S}]|[-_:])",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.directive.seminar seminar.directive.delimiter.slide"
        },
        "2": {
          "name": "markup.heading.slide.seminar entity.name.section.slide.seminar seminar.directive.name.slide"
        }
      },
      "end": "(?!\\[|\\{[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "patterns": [
        {
          "include": "#directive-label"
        },
        {
          "include": "#slide-attribute-block"
        }
      ]
    },
    "directive-step": {
      "begin": "(?<!:)(:)(step)(?![^\\s\\p{P}\\p{S}]|[-_:]|\\[(?!\\]))",
      "beginCaptures": {
        "1": {
          "name": "string.other.begin.directive.seminar seminar.directive.delimiter.step"
        },
        "2": {
          "name": "entity.name.function.step.seminar seminar.directive.name.step"
        }
      },
      "end": "(?!\\[|\\{[ \\t]*(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?)(?:[ \\t]+(?:[#.][^\\s\"'=#.{}]+|[A-Za-z_][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|[^\\s\"'{}]+))?))*[ \\t]*\\})",
      "patterns": [
        {
          "include": "#directive-label"
        },
        {
          "include": "#attribute-block"
        }
      ]
    }
  }
}
