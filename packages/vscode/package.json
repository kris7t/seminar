{
  "name": "seminar-vscode",
  "displayName": "Seminar",
  "description": "Language support for Seminar decks: syntax highlighting and IntelliSense for .deck.mdx files, previews in the editor, and buttons to present and preview them",
  "version": "0.3.1",
  "private": true,
  "publisher": "kris7t",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#00639b",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "seminar",
    "mdx",
    "slides",
    "presentations"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The language server may load TypeScript from the workspace, and presenting a deck runs its project."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onWebviewPanel:seminar.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "seminar.present",
        "title": "Present Deck",
        "category": "Seminar",
        "icon": "$(play)"
      },
      {
        "command": "seminar.preview",
        "title": "Preview Deck",
        "category": "Seminar",
        "icon": "$(open-preview)"
      },
      {
        "command": "seminar.previewInEditor",
        "title": "Preview Deck in the Editor",
        "category": "Seminar"
      },
      {
        "command": "seminar.previewInWindow",
        "title": "Preview Deck in a Window",
        "category": "Seminar"
      },
      {
        "command": "seminar.showDevServerOutput",
        "title": "Show Dev Server Output",
        "category": "Seminar"
      },
      {
        "command": "seminar.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Seminar"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "seminar.present",
          "when": "editorLangId == seminar-deck && resourceScheme == file && !remoteName"
        },
        {
          "command": "seminar.preview",
          "when": "editorLangId == seminar-deck && resourceScheme == file"
        },
        {
          "command": "seminar.previewInEditor",
          "when": "editorLangId == seminar-deck && resourceScheme == file"
        },
        {
          "command": "seminar.previewInWindow",
          "when": "editorLangId == seminar-deck && resourceScheme == file"
        },
        {
          "command": "seminar.showDevServerOutput",
          "when": "seminar.deckOpen"
        },
        {
          "command": "seminar.restartLanguageServer",
          "when": "editorLangId == seminar-deck"
        }
      ],
      "editor/title": [
        {
          "command": "seminar.preview",
          "when": "resourceLangId == seminar-deck && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "seminar.present",
          "when": "resourceLangId == seminar-deck && resourceScheme == file && !remoteName",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "seminar",
          "title": "Seminar",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "seminar": [
        {
          "type": "webview",
          "id": "seminar.contents",
          "name": "Contents",
          "icon": "$(list-tree)",
          "when": "seminar.deckOpen"
        },
        {
          "type": "webview",
          "id": "seminar.steps",
          "name": "Steps",
          "icon": "$(list-ordered)",
          "when": "seminar.deckOpen"
        }
      ]
    },
    "configuration": {
      "title": "Seminar",
      "properties": {
        "seminar.preview.location": {
          "type": "string",
          "enum": [
            "editor",
            "window"
          ],
          "enumDescriptions": [
            "In a panel of the editor, where the deck can't open windows, go full screen, or print.",
            "In a window of its own, or in your browser in a remote workspace."
          ],
          "default": "editor",
          "description": "Where the Preview Deck button shows a deck."
        },
        "seminar.preview.sync": {
          "type": "string",
          "enum": [
            "both",
            "editorToPreview",
            "previewToEditor",
            "off"
          ],
          "enumDescriptions": [
            "Previews follow the cursor, and editors follow the previews.",
            "Previews follow the cursor to its slide, and to its step if it can't be read there.",
            "Editors scroll to the slide and step that previews show.",
            "Previews and editors don't follow each other."
          ],
          "default": "both",
          "description": "How the editor of a deck and its previews follow each other."
        },
        "seminar.preview.dimHidden": {
          "type": "boolean",
          "default": true,
          "description": "Whether to fade the source of what can't be read at the current step of a preview, as much as unused code, except in high contrast themes."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "seminarStepBehavior",
        "description": "A step behavior among the props of a deck."
      },
      {
        "id": "seminarSlideMaster",
        "description": "A slide master among the attributes of a slide."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "seminar-deck",
        "scopes": {
          "seminarStepBehavior": [
            "seminar.attribute.name.step",
            "entity.name.function"
          ],
          "seminarSlideMaster": [
            "seminar.attribute.name.master",
            "entity.name.type"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[seminar-deck]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "taskDefinitions": [
      {
        "type": "seminar",
        "required": [
          "command",
          "deck"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "present",
              "preview"
            ],
            "description": "The command of seminar to run."
          },
          "deck": {
            "type": "string",
            "description": "The path of the deck."
          }
        }
      }
    ],
    "languages": [
      {
        "id": "seminar-deck",
        "aliases": [
          "Seminar Deck"
        ],
        "extensions": [
          ".deck.mdx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/file-icon-light.svg",
          "dark": "./assets/file-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "seminar-deck",
        "scopeName": "source.seminar-deck",
        "path": "./dist/deck.tmLanguage",
        "embeddedLanguages": {
          "meta.embedded.c": "c",
          "meta.embedded.cpp": "cpp",
          "meta.embedded.cs": "csharp",
          "meta.embedded.css": "css",
          "meta.embedded.diff": "diff",
          "meta.embedded.go": "go",
          "meta.embedded.graphql": "graphql",
          "meta.embedded.html": "html",
          "meta.embedded.ini": "ini",
          "meta.embedded.java": "java",
          "meta.embedded.js": "javascriptreact",
          "meta.embedded.json": "json",
          "meta.embedded.kotlin": "kotlin",
          "meta.embedded.less": "less",
          "meta.embedded.lua": "lua",
          "meta.embedded.makefile": "makefile",
          "meta.embedded.md": "markdown",
          "meta.embedded.mdx": "mdx",
          "meta.embedded.objc": "objective-c",
          "meta.embedded.perl": "perl",
          "meta.embedded.php": "php",
          "meta.embedded.python": "python",
          "meta.embedded.r": "r",
          "meta.embedded.ruby": "ruby",
          "meta.embedded.rust": "rust",
          "meta.embedded.scss": "scss",
          "meta.embedded.shell": "shellscript",
          "meta.embedded.sql": "sql",
          "meta.embedded.svg": "xml",
          "meta.embedded.swift": "swift",
          "meta.embedded.toml": "toml",
          "meta.embedded.ts": "typescriptreact",
          "meta.embedded.tsx": "typescriptreact",
          "meta.embedded.vbnet": "vb",
          "meta.embedded.xml": "xml",
          "meta.embedded.yaml": "yaml",
          "meta.embedded.math.seminar": "latex"
        },
        "tokenTypes": {
          "comment.notes.seminar": "other"
        }
      },
      {
        "scopeName": "source.seminar-deck.injection",
        "path": "./syntaxes/deck.injection.tmLanguage.json",
        "injectTo": [
          "source.seminar-deck"
        ]
      },
      {
        "scopeName": "source.seminar-deck.heading",
        "path": "./syntaxes/deck.heading.tmLanguage.json",
        "injectTo": [
          "source.seminar-deck"
        ]
      },
      {
        "scopeName": "source.seminar-deck.steps",
        "path": "./syntaxes/deck.steps.tmLanguage.json",
        "injectTo": [
          "source.seminar-deck"
        ]
      },
      {
        "scopeName": "source.seminar-deck.mermaid",
        "path": "./dist/deck.mermaid.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "vscode:prepublish": "node build.mjs",
    "package": "vsce package --no-dependencies --out dist/seminar.vsix"
  },
  "devDependencies": {
    "@mdx-js/language-service": "0.7.4",
    "@seminar/core": "0.3.1",
    "@seminar/mdx": "0.3.1",
    "@shikijs/langs": "^4.5.0",
    "@types/vscode": "~1.100.0",
    "@volar/language-server": "~2.4.0",
    "@volar/vscode": "~2.4.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "remark-math": "^6.0.0",
    "volar-service-markdown": "0.0.71",
    "volar-service-typescript": "0.0.71",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-uri": "^3.2.0"
  }
}
