{
  "name": "@seminar/cli",
  "version": "0.1.1",
  "description": "Command line for Seminar presentations, e.g., to present decks or print them as PDF",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "seminar": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electron/get": "^5.1.0",
    "@pdfme/pdf-lib": "^6.2.8",
    "prompts": "^2.4.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@seminar/core": "0.1.1",
    "@types/prompts": "^2.4.9",
    "@types/yauzl": "^3.4.0",
    "electron": "45.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/release.mjs prepare"
  }
}
