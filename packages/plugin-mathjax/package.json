{
  "name": "@seminar/plugin-mathjax",
  "version": "0.2.0",
  "description": "Math in Seminar decks, typeset with MathJax when decks are compiled or in the browser",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "seminar": {
    "mdx": {
      "remarkPlugins": {
        "before": [
          {
            "source": "@seminar/plugin-mathjax/compile",
            "exportName": "remarkMath"
          }
        ]
      },
      "rehypePlugins": {
        "after": [
          {
            "source": "@seminar/plugin-mathjax/compile",
            "exportName": "rehypeMathJax"
          }
        ]
      }
    }
  },
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compile": {
      "@seminar/source": "./src/compile.ts",
      "types": "./dist/compile.d.ts",
      "default": "./dist/compile.js"
    },
    "./dynamic": {
      "@seminar/source": "./src/dynamic/index.ts",
      "types": "./dist/dynamic/index.d.ts",
      "default": "./dist/dynamic/index.js"
    },
    "./render": {
      "@seminar/source": "./src/dynamic/render.ts",
      "types": "./dist/dynamic/render.d.ts",
      "default": "./dist/dynamic/render.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!src/fixtures",
    "!src/test",
    "!dist/test",
    "!dist/fixtures",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24"
  },
  "dependencies": {
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@seminar/mdx": "0.2.0",
    "@types/hast": "^3.0.5",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-mdx-jsx": "^3.2.0",
    "remark-math": "^6.0.0",
    "vfile": "^6.0.3"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.2.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.2.0",
    "@testing-library/react": "^16.3.3",
    "react": "^19.3.1",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/plugin-mathjax"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/release.mjs prepare"
  }
}
