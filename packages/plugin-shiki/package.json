{
  "name": "@seminar/plugin-shiki",
  "version": "0.0.0",
  "private": true,
  "description": "Syntax highlighting of code blocks in Seminar decks with Shiki",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "seminar": {
    "mdx": {
      "rehypePlugins": {
        "after": [
          {
            "source": "@seminar/plugin-shiki/rehype",
            "exportName": "rehypeShiki"
          }
        ]
      }
    }
  },
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rehype": {
      "@seminar/source": "./src/rehypeShiki.ts",
      "types": "./dist/rehypeShiki.d.ts",
      "default": "./dist/rehypeShiki.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@seminar/mdx": "0.0.0",
    "shiki": "^4.5.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "mdast-util-mdx-jsx": "^3.2.0",
    "react": "^19.3.1",
    "vfile": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
