{
  "name": "@seminar/vite-plugin",
  "version": "0.1.1",
  "description": "Vite plugin for Seminar presentations",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!src/test",
    "!dist/test",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@seminar/mdx": "0.1.1",
    "@seminar/rollup-plugin": "0.1.1",
    "image-size": "^2.0.4",
    "postcss": "^8.5.30",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "@seminar/core": "0.1.1",
    "@seminar/plugin-mathjax": "0.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/release.mjs prepare"
  }
}
