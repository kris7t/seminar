{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedDeclarations": false,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/example.tsbuildinfo",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vite/client", "@seminar/mdx/client"],
    "jsx": "react-jsx",
    "customConditions": ["@seminar/source"]
  },
  "include": ["src"],
  "references": [
    { "path": "../core/tsconfig.lib.json" },
    { "path": "../mdx/tsconfig.lib.json" },
    { "path": "../vite-plugin/tsconfig.lib.json" }
  ]
}
