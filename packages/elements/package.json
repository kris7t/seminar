{
  "name": "@seminar/elements",
  "version": "0.2.1",
  "description": "Reusable presentation elements for Seminar decks",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "seminar": {
    "directives": {
      "callout": {
        "source": "@seminar/elements",
        "exportName": "CalloutDirective",
        "formProp": "directive",
        "labelProp": "label"
      },
      "columns": {
        "source": "@seminar/elements",
        "exportName": "Columns"
      },
      "column": {
        "source": "@seminar/elements",
        "exportName": "Column",
        "labelProp": "heading",
        "wrapIn": "columns"
      }
    }
  },
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!src/fixtures",
    "!src/test",
    "!dist/test",
    "!dist/fixtures",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.2.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "react": "^19.3.1",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/elements"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/release.mjs prepare"
  }
}
