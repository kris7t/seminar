{
  "name": "@seminar/plugin-pele",
  "version": "0.1.1",
  "description": "Mermaid diagrams in Seminar decks, rendered with Pele",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "seminar": {
    "mdx": {
      "rehypePlugins": {
        "before": [
          {
            "source": "@seminar/plugin-pele/rehype",
            "exportName": "rehypePele"
          }
        ]
      }
    }
  },
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rehype": {
      "@seminar/source": "./src/rehypePele.ts",
      "types": "./dist/rehypePele.d.ts",
      "default": "./dist/rehypePele.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!src/fixtures",
    "!src/test",
    "!dist/test",
    "!dist/fixtures",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@seminar/mdx": "0.1.1",
    "@types/hast": "^3.0.5",
    "mdast-util-mdx-jsx": "^3.2.0",
    "pele": "~1.10.0",
    "vfile": "^6.0.3"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.1.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.1.1",
    "@seminar/plugin-shiki": "0.1.1",
    "@testing-library/react": "^16.3.3",
    "react": "^19.3.1",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/plugin-pele"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/release.mjs prepare"
  }
}
