{
  "name": "@seminar/theme-default",
  "version": "0.1.1",
  "description": "Default theme of Seminar presentations with the Roboto font",
  "homepage": "https://seminar.run",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@seminar/source": "./src/index.ts",
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo",
    "!src/fixtures",
    "!src/test",
    "!dist/test",
    "!dist/fixtures",
    "!dist/**/*.test.*",
    "index.d.ts"
  ],
  "engines": {
    "node": "^22.22.2 || >=24"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0"
  },
  "peerDependencies": {
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.1.1"
  },
  "devDependencies": {
    "@mui/material": "^9.5.0",
    "@seminar/core": "0.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris7t/seminar.git",
    "directory": "packages/theme-default"
  },
  "bugs": {
    "url": "https://github.com/kris7t/seminar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/release.mjs prepare"
  }
}
